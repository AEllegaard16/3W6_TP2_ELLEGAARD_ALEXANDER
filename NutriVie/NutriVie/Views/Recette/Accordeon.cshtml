@model List<RecetteCategorieVM>

<div class="accordion" id="accordeonRecette">
    @foreach (var categorie in Model)
    {
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@categorie.Nom" aria-expanded="false" aria-controls="@categorie.Nom">
                    @categorie.Nom
                </button>
            </h2>
            <div id="@categorie.Nom" class="accordion-collapse collapse"> @* J'ai omis l'attribut "data-bs-parent" afin de garder les éléments ouverts si un autre est ouvert (comportement par défaut : l'autre élément ouvert se ferme lorsque l'autre est ouvert.) *@
                <div class="accordion-body">
                    <partial name="_RecettesCategorie" model="categorie"></partial>
                </div>
            </div>
        </div>
    }
</div>