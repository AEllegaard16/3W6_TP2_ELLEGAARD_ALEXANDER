@using NutriVie.ViewModels
@model List<RecetteCategorieVM>

<div class="accordion" id="accordeonRecette">
    @foreach (RecetteCategorieVM categorie in Model)
    {
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                    @categorie.Nom
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordeonRecette">
                <div class="accordion-body">
                    ¸<partial name="_RecettesCategorie" model="categorie.ListRecetteVM"></partial>
                </div>
            </div>
        </div>
    }
</div>