@model NutriVie.ViewModels.RecetteInfoVM

<tr>
    <td>
        @Model.NomRecette
    </td>
    <td width="250">
        @Model.NbIngredients
    </td>
    <td>
        @Model.TempsTotal
    </td>
    @if (Model.TempsTotal < 50)
    {
        <td class="text-success">Recette de courte durée</td>
    } 
    else if (Model.TempsTotal > 50 && Model.TempsTotal < 90)
    {
        <td class="text-warning">Recette de durée moyenne</td>
    }
    else
    {
        <td class="text-danger">Recette de longue durée</td>
    }
</tr>