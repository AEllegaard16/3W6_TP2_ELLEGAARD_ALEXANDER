@model NutriVie.ViewModels.RecetteCategorieVM

<table class="table">
    <thead>
        <tr>
            <th>
                Nom de la recette
            </th>
            <th>
                Nombre d'ingrédients
            </th>
            <th>
                Temps total (min)
            </th>
            <th>
                Statut
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListRecetteVM)
        {
            <partial name="_RangeeRecette" model="item"></partial>
        }
    </tbody>
</table>
